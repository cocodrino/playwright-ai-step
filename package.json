{
  "name": "playwright-ai-step",
  "version": "0.1.0",
  "type": "module",
  "description": "AI-powered Playwright testing",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openai": "^4.77.0",
    "playwright": "^1.50.0",
    "@playwright/test": "^1.50.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.10.0",
    "vitest": "^3.0.0",
    "@vitest/ui": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./fixtures": {
      "import": "./dist/fixtures.js",
      "types": "./dist/fixtures.d.ts"
    }
  },
  "files": ["dist"]
}
